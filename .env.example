# Copy to .env and fill in. Never commit .env.

# --- provider: OpenRouter, via the OpenAI-compatible protocol ---
OPENROUTER_API_KEY=

# --- app ---
SIGNAL_ENV=dev
SIGNAL_LOG_LEVEL=INFO
SIGNAL_LOG_JSON=true

# --- one model, everywhere ---
# Cheap, 1M context, tool calling + structured outputs. Swap freely; the point
# is to keep it stable so eval numbers are comparable across stages.
SIGNAL_MODEL=deepseek/deepseek-v4.1-flash
SIGNAL_TEMPERATURE=0

# --- reliability ---
SIGNAL_REQUEST_TIMEOUT_S=60
SIGNAL_MAX_RETRIES=3
SIGNAL_RETRY_BASE_DELAY_S=0.5
SIGNAL_RETRY_MAX_DELAY_S=8

# --- budget (per run, enforced in code) ---
SIGNAL_MAX_TOKENS_PER_CALL=1024
SIGNAL_MAX_COST_USD=0.25

# --- storage (stage 4+) ---
DATABASE_URL=postgresql://signal:signal@localhost:5432/signal

# --- tracing (stage 6+) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- outbound actions: keep fake until you deliberately enable real sends ---
EMAIL_PROVIDER=fake
EMAIL_FROM=research@example.com
