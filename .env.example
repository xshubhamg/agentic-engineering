# Copy to .env and fill in. Never commit .env.

# --- model provider (pick one, delete the other) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- app ---
SIGNAL_ENV=dev
SIGNAL_LOG_LEVEL=INFO
SIGNAL_MODEL_STRONG=
SIGNAL_MODEL_CHEAP=
SIGNAL_MODEL_TEMPERATURE=0

# --- limits (enforced in code, not aspirational) ---
SIGNAL_REQUEST_TIMEOUT_S=60
SIGNAL_MAX_RETRIES=3
SIGNAL_MAX_TOKENS_PER_CALL=4096
SIGNAL_MAX_COST_PER_RUN_USD=0.25

# --- storage ---
DATABASE_URL=postgresql://signal:signal@localhost:5432/signal

# --- tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- outbound actions: keep fake until you deliberately enable real sends ---
EMAIL_PROVIDER=fake
EMAIL_FROM=research@example.com
